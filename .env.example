# =============================================================================
# metano 环境变量模板
# -----------------------------------------------------------------------------
# 用法：
#   cp .env.example "$METANO_HOME/.env"    # METANO_HOME 默认 ~/.claude/metano
#   编辑 .env 填写真实值
#
# install.sh / metano.sh 启动时会自动读取 $METANO_HOME/.env（若存在）。
# 也可以直接 export 到 shell 环境（例如写入 ~/.bashrc）。
#
# 占位符（your-key / sk-xxx / xxx 等）会被安装脚本视为“未配置”。
# =============================================================================

# ── 运行时数据目录 ────────────────────────────────────────────────────────────
# 数据库、配置、备份、venv 的根目录。默认 ~/.claude/metano。
METANO_HOME=~/.claude/metano

# ── LLM（Claude / OpenAI 兼容网关）───────────────────────────────────────────
# 建议使用 opencode go 的网关地址；也可填官方 https://api.anthropic.com/v1
# 或其他 OpenAI 兼容端点。
ANTHROPIC_BASE_URL=https://opencode.ai/zen/go
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=your-key

# 模型名：部分模块读 HONCHO_MODEL，部分读 ANTHROPIC_MODEL，建议两者都设。
ANTHROPIC_MODEL=claude-sonnet-4-6
HONCHO_MODEL=claude-sonnet-4-6

# ── 搜索 ─────────────────────────────────────────────────────────────────────
# Tavily 网页搜索（可选；未配置时搜索工具自动降级为 duckduckgo）
TAVILY_API_KEY=your-tavily-key

# ── Home Assistant 智能家居（可选）────────────────────────────────────────────
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-ha-token

# ── 记忆 / 数据 / 备份 ────────────────────────────────────────────────────────
# 记忆库文件路径（默认 <METANO_HOME>/memory.db）
MEMORY_DB=
# 语音（TTS）输出目录（默认 <METANO_HOME>/audio）
VOICE_OUTPUT_DIR=
# 备份保留天数（默认 7，见 backup.sh）
BACKUP_RETENTION_DAYS=7

# ── 本地向量嵌入（知识库语义检索）──────────────────────────────────────────────
# 离线模式：嵌入模型只从本地 HF 缓存加载，不访问网络
HF_HUB_OFFLINE=1
# 嵌入模型（默认 Snowflake/snowflake-arctic-embed-xs）
METANO_EMBED_MODEL=Snowflake/snowflake-arctic-embed-xs
# 指向装有 sentence-transformers + torch 的 python（推荐 cocoindex pipx venv）
# 未设置时 metano 自动探测 cocoindex venv；找不到则语义检索回退 CocoIndex
# METANO_EMBED_PYTHON=~/.local/share/pipx/venvs/cocoindex-code/bin/python

# ── 认证（首次启动生成 admin 用，可选）────────────────────────────────────────
# 若设置，初始管理员密码固定为该值；否则首次启动随机生成并存于 gateway_config.yaml
# HERMES_DEFAULT_PASSWORD=change-me-strong-password
# 建议固定 JWT 密钥（≥32 字符）；不设则自动生成并写入 gateway_config.yaml
# HERMES_JWT_SECRET=

# ── 消息网关：飞书（可选，与 gateway_config.yaml 等价）────────────────────────
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=your-app-secret
# FEISHU_ENCRYPTION_KEY=
# FEISHU_VERIFICATION_TOKEN=

# ── 代理（供依赖下载 / 外部 API 调用）─────────────────────────────────────────
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897
# NO_PROXY=localhost,127.0.0.1,192.168.0.0/16

# ── 其他可选 ──────────────────────────────────────────────────────────────────
# xAI 搜索（metano/x_search.py）
# XAI_API_KEY=your-xai-key
# 图片生成（metano/image_gen.py，OpenAI 兼容）
# OPENAI_API_KEY=your-openai-key
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4o
# 浏览器截图目录（metano/browser.py，默认 /tmp/browser_screenshots）
# BROWSER_SCREENSHOT_DIR=/tmp/browser_screenshots
# 健康检查配置（healthcheck.sh）
# METANO_WEB_URL=http://localhost:9120/health
# METANO_WEB_TIMEOUT=5
# METANO_HEALTH_LOG=<METANO_HOME>/cron/output/healthcheck.log
