# ============================================================
# CC Hermes Bridge 环境变量示例
# 复制为 .env 或直接 export（两者等效，代码用 os.environ 读取）
# ⚠️ 切勿提交真实密钥！.env 已被 .gitignore 忽略
# ============================================================

# ── 核心 LLM（进化引擎/反思器/行为分析都走这里）──────────
ANTHROPIC_API_KEY=sk-ant-xxxx            # Anthropic API key
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-6
HONCHO_MODEL=claude-sonnet-4-6           # 用户建模/反思用的模型

# ── Web 面板认证（不设则自动生成随机密码并打日志）────────
HERMES_JWT_SECRET=change_me_random_string
HERMES_DEFAULT_PASSWORD=change_me_admin_password

# ── 飞书网关（可选，与 gateway_config.yaml 二选一）────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPTION_KEY=
FEISHU_VERIFICATION_TOKEN=

# ── 其他模型提供商（可选）───────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── 智能家居 Home Assistant（可选）──────────────────────
HA_URL=
HA_TOKEN=

# ── 内存数据库路径（可选，默认 ~/.claude/metano/）────────
MEMORY_DB=

# ── 浏览器截图目录（可选）────────────────────────────────
BROWSER_SCREENSHOT_DIR=

# ── DailyHot 热搜 API（可选，本地服务）───────────────────
DAILYHOT_URL=http://127.0.0.1:6688
DAILYHOT_TIMEOUT=5

# ── 网络代理（可选）─────────────────────────────────────
HTTP_PROXY=
HTTPS_PROXY=
