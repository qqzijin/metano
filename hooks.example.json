// ============================================================
// 自我进化引擎 依赖的 Claude Code 钩子配置
// 复制下面内容到 ~/.claude/settings.local.json 的 "hooks" 字段
// （把 __PROJECT_ROOT__ 换成你的项目绝对路径）
//
// B11：SessionStart 不再引用 metano.evolution.session_start（该函数不存在）。
// 实际 SessionStart 钩子是仓库根的 hook_inject_memory.py（按 tag 注入记忆）。
// ============================================================
{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd __PROJECT_ROOT__ && python3 hook_inject_memory.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd __PROJECT_ROOT__ && python3 -c \"from metano.hooks import handle_user_prompt; handle_user_prompt()\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd __PROJECT_ROOT__ && python3 -c \"from metano.hooks import handle_post_tool_use; handle_post_tool_use()\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd __PROJECT_ROOT__ && python3 -c \"from metano.evolution import session_end; session_end()\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
